# ---------------------------------------------------------------------------
# По умолчанию не версионируем НИЧЕГО: ядро WordPress, плагины и загрузки
# живут на сервере и ставятся через WP-CLI по scripts/plugins.txt.
# ---------------------------------------------------------------------------
/*

# ...кроме того, что мы пишем руками:
!.gitignore
!.gitattributes
!README.md
!scripts/

!wp-content/
wp-content/*

!wp-content/themes/
wp-content/themes/*
!wp-content/themes/wportfolio/

!wp-content/mu-plugins/
wp-content/mu-plugins/*
!wp-content/mu-plugins/positum-*.php
!wp-content/mu-plugins/positum-booking/

# ---------------------------------------------------------------------------
# Никогда и ни при каких условиях (правила ниже перебивают всё, что выше):
# ---------------------------------------------------------------------------
wp-config.php
*.log
.htpasswd
